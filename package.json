{
  "name": "awesome-ai-stack",
  "version": "0.1.2",
  "type": "module",
  "description": "A TUI-based package manager for your AI stack. Browse and install MCP servers, memory layers, skills, and agent tools — configured automatically. One command replaces hours of searching.",
  "bin": {
    "aas": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node dist/cli.js",
    "validate": "node scripts/validate.js",
    "sync-skills": "node scripts/sync-skills.js"
  },
  "keywords": [
    "mcp",
    "ai",
    "cli",
    "tui",
    "package-manager",
    "claude",
    "llm",
    "aas"
  ],
  "license": "MIT",
  "author": "Ash310u <ashutoshsaha233@gmail.com> (https://github.com/Ash310u)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ash310u/awesome-ai-stack.git"
  },
  "bugs": {
    "url": "https://github.com/Ash310u/awesome-ai-stack/issues"
  },
  "homepage": "https://github.com/Ash310u/awesome-ai-stack#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "packages"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-checkbox": "^1.0.12",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.2.0",
    "zod": "^3.22.0"
  }
}
