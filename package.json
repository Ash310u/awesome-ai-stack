{
  "name": "aistack",
  "version": "0.1.0",
  "type": "module",
  "description": "TUI-based AI tooling package manager — install MCP servers, memory layers, and AI skills for your role",
  "bin": {
    "aistack": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node dist/cli.js",
    "validate": "node scripts/validate.js",
    "sync-skills": "node scripts/sync-skills.js"
  },
  "keywords": [
    "mcp",
    "ai",
    "cli",
    "tui",
    "package-manager",
    "claude",
    "llm"
  ],
